<!doctype html>
<html lang="hi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>WhatsApp Button</title>
  <style>
    /* केन्द्रित बटन, साधारण सुंदरता */
    body {
      height: 100vh;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Arial, sans-serif;
      background: #f7f7f7;
    }
    .wa-button {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 14px 20px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      font-size: 18px;
      color: white;
      background: #25D366; /* WhatsApp green */
      box-shadow: 0 6px 18px rgba(0,0,0,0.12);
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .wa-button:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0,0,0,0.16); }
    .wa-icon {
      width: 22px;
      height: 22px;
      display: inline-block;
      background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="%23ffffff" d="M380.9 97.1C339-..."/></svg>') center/contain no-repeat;
    }
    /* मोबाइल-फ्रेंडली — बटन पूरा स्क्रीन पर छोटे उपकरणों में */
    @media (max-width:480px){
      .wa-button { width: calc(100% - 40px); justify-content: center; font-size:16px; padding:12px; }
    }
  </style>
</head>
<body>
  <!-- IMPORTANT: नीचे वाले URL में अपना नंबर और (वैकल्पिक) text बदलें -->
  <a class="wa-button" id="waLink" target="_blank" rel="noopener noreferrer"
     href="https://wa.me/919876543210?text=नमस्ते%20—%20मुझे%20आपकी%20सहायता%20चाहिए">
    <!-- आप चाहें तो SVG आइकन सीधे रख सकते हैं या टेक्स्ट ही रखें -->
    <span style="font-size:20px;line-height:1">💬</span>
    <span>WhatsApp पर संपर्क करें</span>
  </a>

  <script>
    // OPTIONAL: अगर आप runtime पर नंबर/मेसेज बदलना चाहें
    // const phone = "919876543210";
    // const msg = encodeURIComponent("नमस्ते, मुझे मदद चाहिए");
    // document.getElementById('waLink').href = `https://wa.me/${phone}?text=${msg}`;
  </script>
</body>
</html>
